@{
    ViewData["Title"] = "Login";
}
@model UserViewModel
<link href="~/css/simpleform.css" rel="stylesheet" />
<section class="main-section">
    <div class="br-class" id="brdiv">
    </div>
    <form class="reg-form" asp-controller="Login" asp-action="EnterUser" asp-area="">

        <label asp-for="Email">Email</label>
        <input asp-for="Email" type="email" />
        <span class="error-span" asp-validation-for="Email"></span>

        <label asp-for="Password">Пароль</label>
        <input asp-for="Password" type="password" />
        <span class="error-span" asp-validation-for="Password"></span>

        <button id="submit-bt" type="submit">Войти</button>
        <a class="form-a" asp-controller="Login" asp-action="Index">Зарегистрироваться</a>
    </form>
</section>
<script src="~/js/loginforms.js"></script>