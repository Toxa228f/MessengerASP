@{
    ViewData["Title"] = "Code";
}
@model string
<style>
    .a-button {
        text-decoration: none;
        color: #252422;
        min-width: 150px;
        max-width: 160px;
        min-height: 40px;
        border-radius: 5px;
        border: 1px solid #252422;
        background-color: #F2F0D8;
        transition: 0.7s all;
        position: relative;
        left: 45%;
    }

        .a-button:hover {
            cursor: default;
            transform: scale(0.95);
            background-color: #d2d0bd;
            text-decoration: none;
            color: #252422;
        }
</style>
<section class="main-section">
    <h1 align="center" style="color:#F2F0D8">@Model</h1>
    <a class="a-button" asp-controller="Chats" asp-action="Index">Продолжить</a>
</section>